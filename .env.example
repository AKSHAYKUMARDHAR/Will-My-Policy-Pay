# Copy to .env. Without a key the catalogue and simulator still work; uploads are off.
GEMINI_API_KEY=                 # free key: https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash   # the lite models were not accurate enough on the dev set
GEMINI_RPM=8
RUNS=2                          # reads per document; a term is shown only when they agree
RATE_LIMIT_PER_HOUR=6           # uploads per connection
STATS_TOKEN=                    # if set, GET /api/stats needs the header X-Stats-Token
KEEP_AWAKE_URL=                 # optional: the app's public URL, pinged every 10 minutes
